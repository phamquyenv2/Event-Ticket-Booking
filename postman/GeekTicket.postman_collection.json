    {
      "name": "03 Booking Happy Path",
      "item": [
        {
          "name": "create booking without voucher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{customerId}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"concertId\": 1,\n  \"items\": [\n    {\n      \"ticketCategoryId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Has booking code\", () => pm.expect(body.data.bookingCode).to.match(/^BK-/));",
                  "pm.test(\"Status RESERVED\", () => pm.expect(body.data.status).to.eql(\"RESERVED\"));",
                  "pm.test(\"Has 1 item\", () => pm.expect(body.data.items).to.have.lengthOf(1));",
                  "pm.test(\"Subtotal > 0\", () => pm.expect(body.data.subtotal).to.be.above(0));",
                  "pm.environment.set(\"bookingId\", body.data.id);",
                  "pm.environment.set(\"bookingCode\", body.data.bookingCode);",
                  "pm.environment.set(\"firstBookingCode\", body.data.bookingCode);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
